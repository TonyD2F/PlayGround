{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "hostinger": {
      "command": [
        "npx",
        "-y",
        "hostinger-api-mcp"
      ],
      "enabled": true,
      "environment": {
        "HOSTINGER_API_TOKEN": "{env:HOSTINGER_API_TOKEN}"
      },
      "type": "local"
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ]
}
